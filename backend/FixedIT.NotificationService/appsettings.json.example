{
  "RabbitMQ": {
    "Host": "",
    "Port": 5672,
    "Username": "",
    "Password": "",
    "VirtualHost": "/",
    "ExchangeName": "fixedit.events",
    "QueueName": "fixedit.notifications",
    "RoutingKey": "notification",
    "DeadLetterExchangeName": "fixedit.events.dlx",
    "DeadLetterQueueName": "fixedit.notifications.dead-letter",
    "DeadLetterRoutingKey": "notification.dead-letter",
    "ConnectionRetrySeconds": 5,
    "PrefetchCount": 1,
    "PublishConfirmTimeoutSeconds": 5,
    "ProcessedMessageCacheSize": 10000,
    "DeliveryRetryDelaysSeconds": [1, 2, 4, 8]
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "Username": "",
    "Password": "",
    "UseSsl": true,
    "FromAddress": "noreply@fixedit.local",
    "FromName": "FixedIT"
  }
}
